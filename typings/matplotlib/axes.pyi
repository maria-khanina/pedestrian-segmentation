class Axes:
    def plot(
        self,
        x: list[int],
        y: list[float],
        *,
        label: str,
        marker: str,
    ) -> None: ...
    def set_xlabel(self, label: str) -> None: ...
    def set_ylabel(self, label: str) -> None: ...
    def set_title(self, label: str) -> None: ...
    def legend(self) -> None: ...
    def grid(self, visible: bool) -> None: ...
